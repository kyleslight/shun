{
  "name": "shun",
  "productName": "Shun",
  "version": "0.1.24",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "desktopName": "Shun",
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "darwin",
        "linux",
        "win32"
      ],
      "cpu": [
        "arm64",
        "x64"
      ],
      "libc": [
        "glibc"
      ]
    }
  },
  "description": "A desktop coding harness for capable models running on consumer GPUs.",
  "author": "Shun",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/build-ios-simulator-driver.mjs && electron-vite dev",
    "build": "node scripts/build-ios-simulator-driver.mjs && electron-vite build",
    "dist:mac": "pnpm build && electron-builder --mac dmg --arm64",
    "package:all": "node scripts/release-local.mjs --build-only",
    "release:publish": "node scripts/release-local.mjs",
    "preview": "electron-vite preview",
    "assets:browser-extension": "node scripts/generate-browser-use-assets.mjs",
    "smoke:browser-use": "node --experimental-strip-types scripts/browser-use-smoke.mjs",
    "test": "node --experimental-strip-types --test src/main/*.test.ts scripts/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@napi-rs/canvas": "1.0.6",
    "defuddle": "0.19.2",
    "diff": "^9.0.0",
    "electron-updater": "6.8.9",
    "fflate": "0.8.2",
    "https-proxy-agent": "7.0.6",
    "linkedom": "0.18.13",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "typebox": "1.3.7",
    "ws": "8.21.3"
  },
  "optionalDependencies": {
    "@mariozechner/clipboard-darwin-arm64": "0.3.9",
    "@mariozechner/clipboard-linux-x64-gnu": "0.3.9",
    "@mariozechner/clipboard-win32-x64-msvc": "0.3.9",
    "@napi-rs/canvas-darwin-arm64": "1.0.6",
    "@napi-rs/canvas-linux-x64-gnu": "1.0.6",
    "@napi-rs/canvas-win32-x64-msvc": "1.0.6"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "8.18.1",
    "dompurify": "^3.4.13",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.12.0",
    "katex": "0.16.47",
    "lucide-preact": "^1.31.0",
    "marked": "^18.0.9",
    "marked-highlight": "^2.2.4",
    "preact": "^10.29.8",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.shun.harness",
    "productName": "Shun",
    "asar": true,
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "kyleslight",
        "repo": "shun"
      }
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "resources/browser-use-extension",
        "to": "browser-use-extension"
      },
      {
        "from": "build/ios-simulator-driver",
        "to": "ios-simulator-driver"
      }
    ],
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/app-icon.icns",
      "hardenedRuntime": true,
      "files": [
        "out/**/*",
        "resources/**/*",
        "package.json",
        "!node_modules/@mariozechner/clipboard-!(darwin-arm64)/**/*",
        "!node_modules/@napi-rs/canvas-!(darwin-arm64)/**/*"
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Shun ${version}",
      "artifactName": "Shun-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "resources/app-icon.png",
      "files": [
        "out/**/*",
        "resources/**/*",
        "package.json",
        "!node_modules/@mariozechner/clipboard-!(win32-x64-msvc)/**/*",
        "!node_modules/@napi-rs/canvas-!(win32-x64-msvc)/**/*"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Shun-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "resources/app-icon.png",
      "category": "Development",
      "maintainer": "Shun",
      "syncDesktopName": true,
      "files": [
        "out/**/*",
        "resources/**/*",
        "package.json",
        "!node_modules/@mariozechner/clipboard-!(linux-x64-gnu)/**/*",
        "!node_modules/@napi-rs/canvas-!(linux-x64-gnu)/**/*"
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Shun-${version}-${arch}.${ext}"
    }
  }
}
