{
  "name": "shun",
  "productName": "Shun",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "description": "An Electron agent product built on the Pi runtime.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:mac": "pnpm build && electron-builder --mac dmg --arm64",
    "preview": "electron-vite preview",
    "test": "node --experimental-strip-types --test src/main/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "@fontsource-variable/newsreader": "^5.3.0",
    "defuddle": "0.19.2",
    "diff": "^9.0.0",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.12.0",
    "linkedom": "0.18.13",
    "lucide-preact": "^1.31.0",
    "marked": "^18.0.9",
    "marked-highlight": "^2.2.4",
    "pdfjs-dist": "^6.2.108",
    "preact": "^10.29.8",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.shun.harness",
    "productName": "Shun",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/app-icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Shun ${version}",
      "artifactName": "Shun-${version}-${arch}.${ext}"
    }
  }
}
