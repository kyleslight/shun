{
  "schemaVersion": 1,
  "id": "sites",
  "name": "Sites",
  "description": "Publish a local web project to a live URL and manage what is online.",
  "version": "0.1.0",
  "publisher": "Shun",
  "distribution": "required",
  "icon": "assets/icon.svg",
  "runtime": {
    "workspace": "optional"
  },
  "permissions": [
    {
      "id": "workspace.read",
      "reason": "Read the built project output you choose to publish."
    }
  ],
  "contributes": {
    "views": [
      {
        "id": "sites.manage",
        "title": "Sites",
        "location": "workspace.right",
        "entry": "ui/index.html",
        "rail": "transient",
        "launch": [
          "user",
          "assistant",
          "tool-result"
        ]
      }
    ],
    "skills": [
      {
        "path": "skills"
      }
    ]
  }
}
