{
  "manifest_version": 3,
  "name": "Shun Browser Use",
  "version": "1.0.0",
  "description": "Lets Shun inspect and control Chrome tabs that you explicitly give to a task.",
  "key": "",
  "permissions": ["debugger", "downloads", "tabs"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": { "service_worker": "service-worker.js" },
  "action": {
    "default_title": "Shun Browser Use",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
